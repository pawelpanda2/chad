# QNAP PROD — environment-specific values for
# docker-compose.server1.test-prod.dashboard.yml. Secrets (Mongo/Postgres/
# Google credentials, SSH) still come from the shared .env.qnap — this file
# holds ONLY the small set of plain values that differ between TEST and
# PROD. Copy to .env.server1.prod (gitignored) and fill in.
#
# Read by bash-scripts/dashboard/05_qnap_prod/*.sh via a second --env-file
# flag (docker compose merges multiple --env-file, later wins) — see that
# directory's 01_config.sh.

COMPOSE_PROJECT_NAME=chad-prod
DASHBOARD_CONTAINER_NAME=chad-dashboard-prod
DASHBOARD_PORT=12030
DASHBOARD_VOLUME_NAME=chad-dashboard-qnap-prod-data
CHAD_ENVIRONMENT=prod

# PROD leaves the Google Sheets info-page sheet names unset by default
# (empty) — set these only once a real per-user spreadsheet map is filled in
# .env.qnap's GOOGLE_SHEETS_SPREADSHEET_MAP.
GOOGLE_SHEETS_DAILY_TRACKER_SHEET_NAME=
GOOGLE_SHEETS_DATE_ENTRIES_SHEET_NAME=
GOOGLE_SHEETS_LEADS_SHEET_NAME=

# PROD never sets GOOGLE_SHEETS_NON_PROD_WRITE_USERS — it doesn't need a
# non-prod write allowlist (it IS prod; see production-guard.ts).
