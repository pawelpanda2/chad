# CHAD MCP server (packages/mcp) — env file for THIS process specifically.
#
# Why a separate file from .env.local: packages/mcp is a plain host process
# (spawned by Odyseusz/ChatGPT via stdio, or run standalone for HTTP), not a
# container — .env.local's Postgres/Mongo hostnames ("postgres", "mongodb")
# only resolve inside the docker-compose network, not on the host. Same
# pattern as plugins/beeper-synch's own .env.mac-beeper (see that file's
# example for the same rationale).
#
# Copy to .env.mcp (repo root) and fill in real values. Never commit
# .env.mcp — only this .example is meant to be committed.

# ============================================
# Identity / repo isolation (packages/mcp/src/identity.ts)
# ============================================
# "local" is required before any write tool is registered. No other value
# is currently supported for MCP_ALLOW_MUTATIONS=true.
MCP_ENVIRONMENT=local

# The ONLY identity this server will ever resolve a repoGuid for — locked to
# "test3" in code (packages/dba/src/testing/test3-guard.ts's established,
# guarded test identity). Any other value makes every cp_* tool fail closed
# with IDENTITY_NOT_CONFIGURED. Never point this at pawel_f/kamil_s/any real
# user.
MCP_TEST_USERNAME=test3

# Explicit opt-in required (in addition to MCP_ENVIRONMENT=local) before
# cp_put_item/cp_create_item are even registered on the server. false/unset
# = read-only server.
MCP_ALLOW_MUTATIONS=true

# ============================================
# dba backend selection — host-side Postgres connection. Local Mac Docker
# publishes container port 5432 to host port 5433 (docker-compose.local.yml)
# — use "localhost:5433" here, NOT the docker-internal "postgres" hostname
# from .env.local. Copy POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB from
# your real .env.local (same values, same running container).
#
# Mongo/legacy Content Provider are explicitly disabled — cp_* tools only
# ever need ONE backend, and this avoids any dependency on Mongo/CP being
# reachable at all for this server to work.
# ============================================
DBA_PRIMARY_BACKEND=postgres
DBA_POSTGRES_ENABLED=true
DBA_MONGO_ENABLED=false
DBA_CONTENT_PROVIDER_ENABLED=false
DBA_FOLLOWER_WRITES_ENABLED=false
DBA_SHADOW_READS_ENABLED=false
POSTGRES_URI=postgres://chad:change_me@localhost:5433/chad

# ============================================
# Transport (packages/mcp/src/config.ts)
# ============================================
# "stdio" (Odyseusz, local agents) or "http" (Streamable HTTP — later
# ChatGPT/remote clients; see human-docs/mcp/README.md before exposing this
# beyond localhost).
MCP_TRANSPORT=stdio

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8420
# Required (no default) when MCP_TRANSPORT=http — generate with e.g.
# `openssl rand -hex 32`. Never commit the real value.
MCP_HTTP_AUTH_TOKEN=change_me

# ============================================
# Limits / logging
# ============================================
MCP_MAX_RESULTS=50
MCP_MAX_PHRASE_LENGTH=200
MCP_SEARCH_TIMEOUT_MS=10000
MCP_LOG_LEVEL=info
