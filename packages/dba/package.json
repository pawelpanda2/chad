{
  "name": "dba",
  "version": "1.0.0",
  "description": "Shared Content Provider + MongoDB (Beeper CRM) database access layer for chad-console and chad-dashboard",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table-columns": {
      "types": "./dist/google-sheets/mapper.d.ts",
      "import": "./dist/google-sheets/mapper.js"
    },
    "./system-folders": {
      "types": "./dist/system-folders.d.ts",
      "import": "./dist/system-folders.js"
    },
    "./beeper-platform": {
      "types": "./dist/beeper-platform.d.ts",
      "import": "./dist/beeper-platform.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "content-provider",
    "database",
    "api-client"
  ],
  "license": "MIT",
  "dependencies": {
    "cp-core": "workspace:*",
    "cp-entry": "workspace:*",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "google-contacts": "workspace:*",
    "js-yaml": "^4.2.0",
    "mongodb": "^7.1.1",
    "openai": "^6.43.0",
    "payments": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "@types/yazl": "^2.4.0",
    "stripe": "^22.4.0",
    "typescript": "^5.3.3",
    "yazl": "^3.3.1"
  }
}