# offline-readonly-backup — emergency read-only CHAD PostgreSQL snapshot.
# Copy to .env beside docker-compose.yml (never commit secrets).

# Root for data outside the repo (postgres volume, dumps, logs, metadata).
CHAD_OFFLINE_READONLY_BACKUP_ROOT=/Users/pawelfluder/03_synch/04_chad_offline_readonly_backup

# Host port published for the backup Postgres (default avoids local-mac :5433).
OFFLINE_READONLY_BACKUP_POSTGRES_PORT=55432

# Superuser used only during restore/refresh (not for CHAD app connections).
OFFLINE_READONLY_BACKUP_ADMIN_USER=chad_offline_readonly_backup_admin
OFFLINE_READONLY_BACKUP_ADMIN_PASSWORD=change_me_admin

# Read-only role password (CHAD app uses this role in offline-readonly-backup mode).
OFFLINE_READONLY_BACKUP_READER_PASSWORD=change_me_reader

# Source server for refresh-from-server.sh (no secrets in logs).
OFFLINE_READONLY_BACKUP_SOURCE_HOST=100.117.139.83
OFFLINE_READONLY_BACKUP_SOURCE_PORT=12042
OFFLINE_READONLY_BACKUP_SOURCE_DB=chad
OFFLINE_READONLY_BACKUP_SOURCE_USER=chad
# Set in shell or a private file — never commit:
# OFFLINE_READONLY_BACKUP_SOURCE_PASSWORD=
