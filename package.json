{
  "name": "chad",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dba": "pnpm --filter dba dev",
    "dba:build": "pnpm --filter dba build",
    "dashboard": "pnpm --filter dashboard dev",
    "console": "pnpm --filter console dev",
    "beeper:ws": "pnpm --filter beeper-ws dev",
    "beeper:sync": "pnpm --filter beeper-sync sync",
    "beeper:sync:force": "pnpm --filter beeper-sync sync:force",
    "beeper:oplog": "pnpm --filter beeper-oplog dev",
    "mcp": "pnpm --filter mcp stdio:dev",
    "mcp:build": "pnpm --filter mcp build",
    "mcp:test": "pnpm --filter mcp build && vitest run packages/mcp/src",
    "mcp:stdio": "pnpm mcp:build && pnpm --filter mcp stdio",
    "mcp:http": "pnpm mcp:build && pnpm --filter mcp http",
    "mongo:up": "docker compose -f docker-compose.local.yml up -d mongodb",
    "mongo:backup": "./bash-scripts/mongo/backup.sh",
    "mongo:restore": "./bash-scripts/mongo/restore.sh",
    "mongo:migrate-contacts": "node ./bash-scripts/mongo/migrate-contacts-to-chad.mjs",
    "mongo:migrate-contacts:apply": "node ./bash-scripts/mongo/migrate-contacts-to-chad.mjs --apply",
    "dev": "./bash-scripts/dev.sh",
    "test:unit": "vitest run packages/dba/src/cp-history/hash.test.ts packages/dba/src/cp-history/diff.test.ts packages/dba/src/testing/test3-guard.test.ts",
    "test:integration:local-mongo": "vitest run packages/dba/src/cp-history/mutate.test.ts && pnpm --filter dba build && cd packages/dba && MONGODB_URI=\"mongodb://localhost:27017/chad_test_story79_ci?directConnection=true\" node dist/cp-history.test.js && MONGODB_URI=\"mongodb://localhost:27017/chad_test_story79_ci?directConnection=true\" node dist/google-sheets/config.test.js",
    "test:cp-history:integrity": "pnpm --filter dba build && node packages/dba/scripts/cp-history-integrity-check.mjs",
    "postgres:up": "docker compose -f docker-compose.local.yml up -d postgres",
    "postgres:migrate": "pnpm --filter dba build && node packages/dba/scripts/apply-postgres-migrations.mjs",
    "test:integration:local-postgres": "pnpm --filter dba build && vitest run packages/dba/src/cp-history/mutate-postgres.test.ts packages/dba/src/data-providers/postgres-cp-provider.test.ts packages/dba/src/data-outbox-postgres.test.ts packages/dba/src/leads-postgres.test.ts packages/dba/src/admin-users-postgres.test.ts",
    "test:cp-postgres-integrity": "pnpm --filter dba build && node packages/dba/scripts/cp-postgres-integrity-check.mjs",
    "test:unit:google-sheets-config": "pnpm --filter dba build && node packages/dba/dist/google-sheets/config.test.js",
    "tables-sync:reconcile": "pnpm --filter dba build && node packages/dba/scripts/reconcile-tables-sheets.mjs",
    "tables-sync:validate-config": "pnpm --filter dba build && node packages/dba/scripts/validate-google-sheets-config.mjs"
  },
  "dependencies": {
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
