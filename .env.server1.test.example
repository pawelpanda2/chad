# QNAP TEST — environment-specific values for
# docker-compose.server1.test-prod.dashboard.yml. Secrets (Mongo/Postgres/
# Google credentials, SSH) still come from the shared .env.qnap — this file
# holds ONLY the small set of plain values that differ between TEST and
# PROD. Copy to .env.server1.test (gitignored) and fill in.
#
# Read by bash-scripts/dashboard/04_qnap_test/*.sh via a second --env-file
# flag (docker compose merges multiple --env-file, later wins) — see that
# directory's 01_config.sh.

COMPOSE_PROJECT_NAME=chad-test
DASHBOARD_CONTAINER_NAME=chad-dashboard-test
DASHBOARD_PORT=12020
DASHBOARD_VOLUME_NAME=chad-dashboard-qnap-test-data
CHAD_ENVIRONMENT=test

# TEST wires the Google Sheets INFO PAGE only (spreadsheet link, read-only —
# see .env.qnap.example's Google Sheets section for the write-vs-info-page
# split). Non-empty sheet-name defaults here, unlike PROD, are historical —
# TEST is where sheet-name defaults were first exercised.
GOOGLE_SHEETS_DAILY_TRACKER_SHEET_NAME=daily
GOOGLE_SHEETS_DATE_ENTRIES_SHEET_NAME=dates
GOOGLE_SHEETS_LEADS_SHEET_NAME=leads

# TEST-only: Google Sheets WRITE sync additionally allowlists these
# usernames even outside real PROD (packages/dba/src/google-sheets/
# production-guard.ts's checkGoogleSheetsWriteAllowed) — default test3 (the
# resettable sandbox), never test2 (see test2:reset guard docs).
GOOGLE_SHEETS_NON_PROD_WRITE_USERS=test3

# 2026-07-28 P0 fix (session-token.ts) — same value as .env.server1.prod
# (see that file's own comment for why). TEST is plain HTTP, so
# AUTH_COOKIE_SECURE stays false/unset here.
SESSION_SIGNING_SECRET=
