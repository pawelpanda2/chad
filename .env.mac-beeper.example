# Mac-side env for beeper-ws / beeper-sync / beeper-synch (packages/beeper-ws,
# packages/beeper-sync, plugins/beeper-synch — see ai-docs/beeper/ai-start.md).
#
# These processes run on the Mac (next to Beeper Desktop). As of Story 91,
# the target MongoDB is QNAP's standalone `beeper-mongodb` (Story 76),
# reached over Tailscale — not the local Mongo used by Story 59's original
# Phase 0 setup. Story 59 Phase 2/3 (the "future QNAP form" this file used
# to describe) is complete.
#
# Copy this to `.env.mac-beeper` (gitignored, never commit it) and fill in
# the REAL values there (Beeper API key, Mongo credentials — see
# .env.qnap's BEEPER_MONGO_ROOT_USERNAME/PASSWORD). Never put real secrets
# in this committed .example file.

# QNAP's beeper-mongodb over Tailscale (100.117.139.83 — see
# ai-docs/deploy for the QNAP Tailscale host, port 12041 is this service's
# published port, see docker-compose.qnap.shared.yml). Standalone, no
# replica set, so no directConnection=true needed. Server URI only — no
# database segment. Story 73: each CHAD user gets their own
# `beeper_<repoGuid>` database (see BEEPER_OWNER_REPO_GUID below); the old
# single shared `beeper` database is retired.
MONGODB_URI=mongodb://change_me:change_me@100.117.139.83:12041/?authSource=admin

# Story 73: required. This process has no Dashboard session to resolve a
# repoGuid from, so the owner of this Mac's Beeper data must be configured
# explicitly — beeper-ws/beeper-sync/beeper-synch refuse to start without a
# full GUID here, and will only ever read/write `beeper_<repoGuid>`, never
# any other user's database. See ai-docs/beeper/ai-start.md.
BEEPER_OWNER_REPO_GUID=21d11bdc-f1f4-44d1-b61a-3fa6b039c641
# A future kamil_s device would use 8b603669-f8e6-4224-bd78-a474998995fa.

# Beeper Desktop local endpoints (same-machine assumption — see
# documentation/ai-docs/2026-07-10_decision-beeper-mac-qnap-architecture.md)
BEEPER_WS_URL=ws://localhost:23373/v1/ws
BEEPER_REST_URL=http://localhost:23373
BEEPER_API_KEY=change_me

# ── beeper-synch (Story 91) orchestrator-only settings — plugins/beeper-synch ──
# All optional; defaults shown. Not read by beeper-ws/beeper-sync themselves.

# How often plugins/beeper-synch runs a beeper-sync incremental REST pass.
# BEEPER_SYNCH_SYNC_INTERVAL_MS=300000

# Bounds for beeper-ws supervised-restart backoff.
# BEEPER_SYNCH_MIN_BACKOFF_MS=2000
# BEEPER_SYNCH_MAX_BACKOFF_MS=300000

# Free-form label for this machine/instance, shown in beeper-synch logs only.
# BEEPER_SYNCH_INSTANCE_ID=mac-default
# BEEPER_SYNCH_LOG_LEVEL=info

# Local Beeper SQLite path used by beeper-sync — must come from env, never
# hardcoded in scripts (source repo had this hardcoded, to be fixed on migration)
BEEPER_SQLITE_PATH=/Users/change_me/Library/Application Support/BeeperTexts/index.db

# Optional: only set this if account.db lives outside BEEPER_SQLITE_PATH's
# directory. By default beeper-sync/enrich-from-sqlite.mjs derives it as
# "account.db" next to BEEPER_SQLITE_PATH (same BeeperTexts folder).
# BEEPER_SQLITE_ACCOUNT_PATH=/Users/change_me/Library/Application Support/BeeperTexts/account.db
